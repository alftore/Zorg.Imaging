<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Managed image decoding, resizing and encoding for .NET: PNG, JPEG, GIF and WebP, with no native dependencies.</Description>
    <PackageTags>image;imaging;resize;thumbnail;png;jpeg;gif;webp;exif</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zorg.Imaging.Tests" />
    <InternalsVisibleTo Include="Zorg.Imaging.AotSmoke" />
  </ItemGroup>

</Project>
