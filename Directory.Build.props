<Project>
  <PropertyGroup>
    <!-- Language and framework -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Quality gates. GenerateDocumentationFile stays on in every project: IDE0005 needs it at build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Features>strict</Features>

    <!-- Determinism -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Packaging metadata -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Zorg.Imaging contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/alftore/Zorg.Imaging</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/alftore/Zorg.Imaging/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/alftore/Zorg.Imaging.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>false</IsPackable>

    <!-- Relative to the repo root, so a checkout path that contains "src" or "tests" can't change the result. -->
    <ZorgProjectPath>$([MSBuild]::MakeRelative($(MSBuildThisFileDirectory), $(MSBuildProjectDirectory)))</ZorgProjectPath>
  </PropertyGroup>

  <!-- Library projects (src/) -->
  <PropertyGroup Condition="$(ZorgProjectPath.StartsWith('src'))">
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- No runtime dependencies, so references can be verified too. -->
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- BenchmarkDotNet generates and builds a project of its own under bin/, which these files reach too: its code isn't ours to analyse. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'BenchmarkDotNet.Autogenerated'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>false</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)PACKAGE.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
